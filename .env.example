# ==============================================================================
# CivicLoop - Environment Configuration (.env.example)
# Open-Source AI Agent for Persistent Civic Problem Management (Bengaluru)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="CivicLoop"
API_V1_STR="/api/v1"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database (PostgreSQL with pgvector)
# For Docker Compose: postgresql+psycopg2://civicloop:civicloop_secret@postgres:5432/civicloop_db
# For Local Development: postgresql+psycopg2://civicloop:civicloop_secret@localhost:5432/civicloop_db
DATABASE_URL=postgresql+psycopg2://civicloop:civicloop_secret@postgres:5432/civicloop_db

# Security & Authentication
SECRET_KEY=civicloop-insecure-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# OPEN-WEIGHT MODEL CONFIGURATION (HARD CONSTRAINTS 1 & 2)
# NEVER import or call closed-model APIs (OpenAI, Anthropic, Google Gemini).
# All model access goes through backend/app/ai/llm.py pointed at an OpenAI-compatible
# endpoint (vLLM, Ollama, or hosted open-weight provider).
# ==============================================================================
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama-or-vllm-key
LLM_AGENT_MODEL=deepseek-ai/DeepSeek-V4
LLM_VISION_MODEL=Qwen/Qwen3.6-VL
EMBED_MODEL=BAAI/bge-m3

# Worker Configuration
WORKER_POLL_INTERVAL_SECONDS=5
MAX_TASK_ATTEMPTS=3
